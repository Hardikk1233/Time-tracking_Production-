# Configuration reference for the API server.
# Every variable below is declared and validated in
# artifacts/api-server/src/config.ts — the server refuses to start if a
# required one is missing, rather than falling back to an insecure default.
#
# Copy to .env for local notes; the app itself reads real environment
# variables (Container Apps injects them from Key Vault in production).

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string.
DATABASE_URL=postgresql://postgres@localhost:5432/timetracker

# express-session signing secret. Optional in development (falls back to a
# clearly-marked dev value); REQUIRED in production — startup fails without it.
# Becomes obsolete once Entra ID replaces session auth.
SESSION_SECRET=change-me

# ─── Runtime ─────────────────────────────────────────────────────────────────

# development | production. Controls log format, secure cookies, and the
# defaults for DATABASE_SSL and TRUST_PROXY below.
NODE_ENV=development

# Port to listen on. Container Apps injects this; 8080 matches the Dockerfile.
PORT=8080

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Frontend ────────────────────────────────────────────────────────────────

# Absolute path to the built React app. Set in the container so one process
# serves both the API and the UI. Leave unset locally when using Vite's dev
# server — the API then serves the API only.
# STATIC_DIR=/app/public

# ─── Database connection ─────────────────────────────────────────────────────

# Azure Database for PostgreSQL requires TLS. Defaults to true in production,
# false in development where local Postgres has no certificate.
# DATABASE_SSL=true

# Verify the server certificate. Leave true unless a proxy re-signs the
# connection; turning it off removes protection against interception.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Connections per replica. The B1ms database tier allows roughly 35 total and
# the API can scale to 3 replicas, so 8 leaves headroom for migrations and
# admin sessions. Raise only alongside a larger database tier.
# DATABASE_POOL_MAX=8
# DATABASE_POOL_IDLE_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=10000

# ─── Networking ──────────────────────────────────────────────────────────────

# Comma-separated CORS allowlist. Leave EMPTY in production: the container
# serves the frontend, so browser calls are same-origin and need no CORS grant.
# Set only for a frontend served from a different origin in development.
# CORS_ORIGINS=http://localhost:5173

# Trust X-Forwarded-* headers from the ingress proxy — required for secure
# cookies and correct client IPs behind Container Apps. Defaults to true in
# production. Never enable when the app is directly internet-facing.
# TRUST_PROXY=true

# ─── Microsoft Entra ID ──────────────────────────────────────────────────────
#
# Leave every variable below unset and the API stays on password sign-in
# exactly as before. Set TENANT_ID and AUDIENCE together and it *also* accepts
# Entra bearer tokens, so both work during the migration. Set ENTRA_ONLY=true
# to finish the cutover and retire passwords.
#
# Directory (tenant) ID from the Azure portal.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#
# Application ID URI of the API app registration — the audience every token
# must be issued for. Anything addressed elsewhere is refused.
# ENTRA_AUDIENCE=api://timetrack-api
#
# Handed to the browser so the sign-in page can start MSAL. Not secret.
# ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_API_SCOPE=api://timetrack-api/access_as_user
#
# Overrides for sovereign clouds or tests; derived from the tenant otherwise.
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
#
# The cutover switch: refuses password sign-in entirely.
# ENTRA_ONLY=false

# ─── Temporary rollout tooling ───────────────────────────────────────────────
#
# The /dev console and the feedback widget. Both exist to get the Entra rollout
# debugged and are meant to be removed afterwards — see docs/dev-console.md.

# Comma-separated emails allowed to open /dev. UNSET DISABLES THE CONSOLE: an
# absent access list must never mean "open to everyone", and it will be absent
# in every environment nobody has deliberately configured.
# DEV_CONSOLE_EMAILS=hardik.pandey@tristone-partners.com

# Where to POST when feedback arrives — a Teams incoming webhook, or anything
# else accepting {"text": "..."}. Unset means the unread count on /dev is the
# only signal that something came in.
# FEEDBACK_WEBHOOK_URL=https://prod-00.westus.logic.azure.com:443/workflows/...

# How many captured events to keep. The oldest are trimmed on write, so one
# browser stuck in a render loop cannot fill the volume the timesheets live on.
# DEV_EVENT_RETENTION=5000

# ─── Migrations ──────────────────────────────────────────────────────────────

# Folder holding generated SQL migrations, used by `node dist/migrate.mjs`.
# Defaults to ./drizzle next to the bundle, which is the container layout.
# Locally: MIGRATIONS_DIR=<repo>/lib/db/drizzle
# MIGRATIONS_DIR=/app/drizzle
