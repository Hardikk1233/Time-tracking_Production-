{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    // No rootDir: this config only type-checks (--noEmit) — esbuild produces
    // the bundle — and the test files sit outside src/.
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.ts"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    }
  ]
}
